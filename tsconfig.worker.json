{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "composite": true,
    "outDir": "./dist/worker",
    "rootDir": ".",
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "src/server/**/*",
    "src/engine/**/*",
    "src/shared/**/*",
    "content/**/*"
  ]
}
