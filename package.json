{
  "name": "cf_ai_haunted_house",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env XDG_CONFIG_HOME=.wrangler-local vite dev",
    "dev:ai": "cross-env XDG_CONFIG_HOME=.wrangler-local MOCK_LLM=0 vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "types": "wrangler types",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:engine-purity": "tsx scripts/check-engine-purity.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:doc": "tsx scripts/gen-content-doc.ts",
    "playthrough": "tsx scripts/playthrough.ts",
    "test": "vitest run -c vitest.config.ts",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "eval:llm": "tsx scripts/llm-eval.ts",
    "check": "npm run types && npm run lint && npm run typecheck && npm run check:engine-purity && npm run content:validate && npm run test && npm run build",
    "deploy": "npm run check && vite build && wrangler deploy",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@cloudflare/ai-chat": "^0.12.0",
    "agents": "^0.24.0",
    "ai": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cross-env": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
