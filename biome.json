{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noAssignInExpressions": "off"
      }
    }
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": { "enabled": false },
  "files": { "includes": ["**", "!node_modules/**", "!dist/**", "!.wrangler/**", "!worker-configuration.d.ts"] }
}
